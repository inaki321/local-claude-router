# Copy to ~/.config/litellm/env and chmod 600. Never commit the filled copy.
# install.sh creates this file from the example and refuses to start the
# service while REPLACE_WITH placeholders remain.

# Shared secret between Claude Code and LiteLLM. Keep ~/.claude/settings.json
# ANTHROPIC_AUTH_TOKEN in sync with this value.
LITELLM_MASTER_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
LITHOSAI_API_KEY=REPLACE_WITH_LITHOS_API_KEY
