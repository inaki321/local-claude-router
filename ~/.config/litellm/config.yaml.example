# LiteLLM gateway - the single local Anthropic-compatible endpoint.
#
#   claude -> this proxy :4000 --+-> api.deepseek.com/anthropic   (passthrough)
#                                +-> openrouter                   (native provider)
#                                +-> api.lithosai.cloud/v1        (translated)
#
# model_list names intentionally match the strings already used in
# ~/.claude/settings.json, so /model and the modelPicker are unchanged.
#
# Deploy with: ./install.sh
# Verify before pointing Claude Code at it: see litellm/README.md.

model_list:
  # --- DeepSeek direct (Anthropic-native endpoint, kept as passthrough) ---
  - model_name: deepseek-v4-flash
    litellm_params:
      model: anthropic/deepseek-v4-flash
      api_base: https://api.deepseek.com/anthropic
      api_key: os.environ/DEEPSEEK_API_KEY

  - model_name: deepseek-v4-pro
    litellm_params:
      model: anthropic/deepseek-v4-pro
      api_base: https://api.deepseek.com/anthropic
      api_key: os.environ/DEEPSEEK_API_KEY

  # --- OpenRouter (LiteLLM's native provider; handles :free ids) ---
  - model_name: openai/gpt-oss-120b
    litellm_params:
      model: openrouter/openai/gpt-oss-120b
      api_key: os.environ/OPENROUTER_API_KEY

  - model_name: google/gemma-4-26b-a4b-it:free
    litellm_params:
      model: openrouter/google/gemma-4-26b-a4b-it:free
      api_key: os.environ/OPENROUTER_API_KEY

  - model_name: nvidia/nemotron-3-ultra-550b-a55b:free
    litellm_params:
      model: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
      api_key: os.environ/OPENROUTER_API_KEY

  - model_name: nvidia/nemotron-3.5-lightning:free
    litellm_params:
      model: openrouter/nvidia/nemotron-3.5-lightning:free
      api_key: os.environ/OPENROUTER_API_KEY

  # Target for the "or" shortcut.
  - model_name: deepseek/deepseek-chat
    litellm_params:
      model: openrouter/deepseek/deepseek-chat
      api_key: os.environ/OPENROUTER_API_KEY

  # --- LithosAI (OpenAI-compatible, translated) ---
  # Reasoning model: it returns reasoning_content before the answer, so give
  # it a real max_tokens budget.
  - model_name: deepseek-v4-flash-lith
    litellm_params:
      model: openai/deepseek-ai/DeepSeek-V4.1-Flash
      api_base: https://api.lithosai.cloud/v1
      api_key: os.environ/LITHOSAI_API_KEY

  # --- Ollama (local) ---
  # num_ctx is per request and overrides the unit's OLLAMA_CONTEXT_LENGTH.
  # The 4B gets 80k: Claude Code's system prompt + tool definitions is ~35k
  # tokens, so a 32k window leaves no room to work. See OLLAMA.md.
  - model_name: qwen2.5-coder-1.5b
    litellm_params:
      model: ollama_chat/qwen2.5-coder:1.5b
      api_base: http://127.0.0.1:11434
      num_ctx: 32768
      drop_params: true
      # Claude Code always sends Anthropic "thinking"; LiteLLM maps it to
      # reasoning_effort -> Ollama "think", which this model rejects with 400.
      # Force it off for Ollama models without thinking support.
      think: false
      # No api_key needed for local Ollama

  # 7B coding model - 5.1 GiB at 32k with the q4_0 KV cache. Keep it at 32k;
  # it does not fit at the 4B's 80k window on 8 GiB.
  - model_name: qwen2.5-coder-7b
    litellm_params:
      model: ollama_chat/qwen2.5-coder:7b-instruct-q4_K_M
      api_base: http://127.0.0.1:11434
      num_ctx: 32768
      drop_params: true
      think: false

  # Qwen3 4B Instruct (non-thinking) - the usable local pick.
  # 6.3 GiB at 80k with the q4_0 KV cache, 100% on the GPU.
  - model_name: qwen3-4b-instruct-2507
    litellm_params:
      model: ollama_chat/qwen3:4b-instruct-2507-q4_K_M
      api_base: http://127.0.0.1:11434
      num_ctx: 81920
      drop_params: true
      think: false

router_settings:
  # Equivalent of the old providers.json "aliases". Targets must be existing
  # model_name values. hidden: true keeps them out of /v1/models.
  model_group_alias:
    ds:       { model: deepseek-v4-flash, hidden: true }
    ds-flash: { model: deepseek-v4-flash, hidden: true }
    ds-pro:   { model: deepseek-v4-pro, hidden: true }
    or:       { model: deepseek/deepseek-chat, hidden: true }
    gemma:    { model: google/gemma-4-26b-a4b-it:free, hidden: true }
    nemotron: { model: nvidia/nemotron-3-ultra-550b-a55b:free, hidden: true }
    lightning: { model: nvidia/nemotron-3.5-lightning:free, hidden: true }
    gpt-oss:  { model: openai/gpt-oss-120b, hidden: true }
    lith:     { model: deepseek-v4-flash-lith, hidden: true }
    qwen2.5:     { model: qwen2.5-coder-1.5b, hidden: true }
    qwen7b:      { model: qwen2.5-coder-7b, hidden: true }
    qwen4b:      { model: qwen3-4b-instruct-2507, hidden: true }

litellm_settings:
  # Claude Code talks to /v1/messages. Without this flag LiteLLM routes
  # openai/ deployments to /v1/responses, which LithosAI does not implement
  # (404 -> deployment cooldown -> 429 "No deployments available").
  use_chat_completions_url_for_anthropic_messages: true
  # Claude Code sends Anthropic-specific parameters (thinking, effort, ...).
  # OpenAI-only backends reject them; drop rather than 400.
  drop_params: true

general_settings:
  # Claude Code authenticates with ANTHROPIC_AUTH_TOKEN; LiteLLM accepts it as
  # Authorization: Bearer. Set the same value in ~/.claude/settings.json.
  master_key: os.environ/LITELLM_MASTER_KEY
